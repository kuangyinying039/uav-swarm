{
  "protocol": "isaac_physx_dual_capture_medium_train_four_level_transfer_v2_sample_efficiency",
  "execution_backend": "isaac_physx",
  "train_level": "medium",
  "capture_required_uavs": 2,
  "execution_reward_version": 5,
  "episodes_per_seed": 1000,
  "episode_budget_checkpoints": [250, 500, 750, 1000],
  "training_seeds": [11, 12, 13],
  "evaluation_seed_start": 7000000,
  "evaluation_seed_count": 200,
  "budget_evaluation_seed_count": 50,
  "extras_seed_count": 50,
  "evaluation_levels": ["nominal", "medium", "hard", "extreme"],
  "test_checkpoint_policy": "one checkpoint trained only on dual_medium per algorithm/variant, evaluated unchanged at all four levels",
  "domain_seeds": "training seed s uses episode seeds s*100000 + episode_index; evaluation uses the same 7000000..7000199 for every method and level",
  "sample_efficiency_notes": "exploration/BC decay steps scale with episodes (min(150000, max(20000, episodes*100))); budget snapshots enable 250/500/750/1000 curves",
  "method_selection_rule": "primary proposed method = argmax mean Dual-Medium capture_rate over seeds {11,12,13} among {mappo_dagger, A5}; ties broken by mean Hard capture_rate then lower mean_censored_steps",
  "environment_profiles": {
    "nominal": "configs/pursuit_v2/radar5_dual_nominal.json",
    "medium": "configs/pursuit_v2/radar5_dual_medium.json",
    "hard": "configs/pursuit_v2/radar5_dual_hard.json",
    "extreme": "configs/pursuit_v2/radar5_dual_extreme.json",
    "ablation_visibility_off": "configs/pursuit_v2/radar5_dual_ablation_no_visibility_medium.json",
    "ablation_no_encircle": "configs/pursuit_v2/radar5_dual_ablation_no_encircle_medium.json",
    "ablation_no_team_progress": "configs/pursuit_v2/radar5_dual_ablation_no_team_progress_medium.json",
    "ablation_no_freshness": "configs/pursuit_v2/radar5_dual_ablation_no_freshness_medium.json",
    "oracle_medium": "configs/pursuit_v2/radar5_dual_oracle_medium.json",
    "single_capture_medium": "configs/pursuit_v2/radar5_dual_single_capture_medium.json"
  },
  "comparison_methods": ["apf", "frpn", "mpc", "mappo_dagger", "A5"],
  "key_ablations": ["A0", "A1", "A2", "A4c", "A5"],
  "ablations": {
    "A0": {"algorithm": "MATD3", "actor": "MLP", "initialization": "scratch", "prior_fraction": 0.0, "warmup_policy": "random"},
    "A1": {"algorithm": "HGAT-MATD3", "actor": "HGAT", "initialization": "scratch", "prior_fraction": 0.0, "warmup_policy": "random"},
    "A2": {"algorithm": "HGAT-MATD3", "actor": "Isaac MPC-DAgger", "prior_fraction": 0.5, "warmup_policy": "actor", "critic_pretrain_updates": 0, "demo_bc": false},
    "A3": {"algorithm": "HGAT-MATD3", "actor": "Isaac MPC-DAgger", "prior_fraction": 0.5, "warmup_policy": "actor", "critic_pretrain_updates": 0, "demo_bc": "1.0->0.05"},
    "A4": {"algorithm": "HGAT-MATD3", "actor": "Isaac MPC-DAgger", "environment": "ablation_visibility_off", "prior": "medium_no_visibility_prior", "note": "historical confounded ablation; prefer A4c"},
    "A4c": {"algorithm": "HGAT-MATD3", "actor": "Isaac MPC-DAgger", "environment": "ablation_visibility_off", "prior": "medium_mpc_prior", "prior_fraction": 0.5, "warmup_policy": "actor", "critic_pretrain_updates": 5000, "demo_bc": "1.0->0.05", "note": "clean visibility ablation"},
    "A5": {"algorithm": "HGAT-MATD3", "actor": "Isaac MPC-DAgger", "prior_fraction": 0.5, "warmup_policy": "actor", "critic_pretrain_updates": 5000, "demo_bc": "1.0->0.05"}
  },
  "reward_ablations_seed11": ["no_encircle", "no_team_progress", "no_freshness"],
  "extras": ["oracle_vs_lidar_baselines", "single_vs_dual_capture_mpc", "mpc_teacher_roles", "freshness_off_mpc"],
  "out_of_scope": ["weak_communication", "search_pursuit_joint_training"],
  "matd3_defaults": {
    "batch_size": 256,
    "replay_size": 500000,
    "warmup_steps": 8000,
    "actor_lr": 0.00005,
    "critic_lr": 0.0003,
    "exploration_std": 0.1,
    "exploration_final_std": 0.03,
    "policy_delay": 2,
    "tau": 0.005,
    "utd": 1
  },
  "artifacts_must_record_execution_backend": "isaac_physx",
  "old_kinematic_checkpoints_and_priors_allowed": false
}
